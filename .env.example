# Copy to .env and adjust. Values below match docker-compose.yml.

APP_ENV=local

# Postgres from `docker compose up -d db` (host port 5433 so it doesn't clash with a local Postgres)
DATABASE_URL=postgresql+asyncpg://rokkha:rokkha@localhost:5433/rokkha
TEST_DATABASE_URL=postgresql+asyncpg://rokkha:rokkha@localhost:5433/rokkha_test

# Redis from `docker compose up -d redis` (pub/sub for live updates, job queue, rate limits)
REDIS_URL=redis://localhost:6379/0

# Optional: enables POST /gds/ai-draft. Groq has a free tier (console.groq.com).
# AI_PROVIDER=auto picks whichever key is set. Leave both empty to disable.
AI_PROVIDER=auto
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# bcrypt cost factor (12 in production; tests use 4 to stay fast)
BCRYPT_ROUNDS=12
